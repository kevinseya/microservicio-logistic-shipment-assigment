{
    "swagger": "2.0",
    "info": {
      "title": "Create Shippment API",
      "description": "API para gestionar envíos.",
      "contact": {}
    },
    "paths": {
      "/api/shippment/create": {
        "post": {
          "summary": "Create a new Shippment",
          "description": "This endpoint allow create a new shippment to database",
          "tags": ["shippment"],
          "consumes": ["application/json"],
          "produces": ["application/json"],
          "parameters": [
            {
              "in": "body",
              "name": "shipment",
              "description": "Data of shippment",
              "required": true,
              "schema": {
                "$ref": "#/definitions/Shipment"
              }
            }
          ],
          "responses": {
            "201": {
              "description": "Envío creado exitosamente",
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "shippment-asignment": {
                    "$ref": "#/definitions/Shipment"
                  }
                }
              }
            },
            "400": {
              "description": "Error al crear el envío",
              "schema": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "string"
                  }
                }
              }
            },
            "500": {
              "description": "Error interno del servidor",
              "schema": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "definitions": {
      "Shipment": {
        "type": "object",
        "properties": {
          "shipmentID": {
            "type": "integer",
            "description": "ID del envío (auto-generado)"
          },
          "orderID": {
            "type": "integer",
            "description": "ID de la orden asociada"
          },
          "carrierID": {
            "type": "integer",
            "description": "ID del transportista asociado"
          },
          "state": {
            "type": "string",
            "description": "Estado del envío",
            "default": "pendiente"
          },
          "dateAsignment": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de asignación del envío (auto-generada)"
          }
        },
        "required": ["orderID", "carrierID"]
      }
    }
  }
  